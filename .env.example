# --- kabuステーションAPI（auカブコム証券）---
# 本番: http://localhost:18080 / 検証(デモ): http://localhost:18081
KABU_API_BASE_URL=http://localhost:18080
KABU_API_PASSWORD=your-api-password
KABU_ORDER_PASSWORD=your-order-password

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- 対象銘柄（証券コードをカンマ区切りで指定）---
SYMBOLS=7203,9984

# --- リスク管理 ---
# 1回の注文で使う予算（円）。日本株は基本100株単位（単元株）のため、
# 「価格 x 100」を下回る予算では1単元も買えず注文が見送られる点に注意。
# 例: 株価1,000円の銘柄を買うには最低100,000円の予算が必要。
ORDER_SIZE_YEN=100000
# 本日の損益がこの金額（円）を下回ったら新規注文を停止する。
DAILY_MAX_LOSS_YEN=5000

# --- 安全装置 ---
# true の間は実際の発注を行わず、判断結果をログ/trade_log.csvに出力するだけ。
# 十分に動作を確認してから false に変更すること。
DRY_RUN=true

# 状態/ログの保存先（省略可）
RISK_STATE_PATH=risk_state.json
TRADE_LOG_PATH=trade_log.csv
